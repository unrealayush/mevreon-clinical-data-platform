# Mevreon GCP Frontend — env config
# API base of the GCP FastAPI gateway (no trailing slash).
# When served from the same origin as the API, leave empty.
VITE_API_BASE=https://mevreon-backend-xxxxx-uc.a.run.app

# Login uses API access keys (AWS IAM-style), validated by the backend:
#   API_ACCESS_KEY / API_SECRET_KEY  (set on the Cloud Run backend service)
# There are no frontend key env vars — users type the keys into the
# "Secure Clinical Login" screen and receive a JWT stored locally.

